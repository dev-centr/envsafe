<?xml version="1.0" encoding="utf-8"?>
<!-- WiX v5 per-machine installer: installs envsafe.exe and adds its folder to the system PATH. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="envsafe"
           Manufacturer="Dev-Centr"
           Version="$(Version)"
           UpgradeCode="6B1D3C52-8E0F-4C1B-9A57-2F4E8D3A7C10"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of envsafe is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="envsafe">
        <Component Id="EnvsafeExe">
          <File Id="EnvsafeExeFile" Source="$(ExePath)" KeyPath="yes" />
          <Environment Id="EnvsafePath" Name="PATH" Value="[INSTALLFOLDER]"
                       Action="set" Part="last" System="yes" Permanent="no" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="envsafe">
      <ComponentRef Id="EnvsafeExe" />
    </Feature>
  </Package>
</Wix>
